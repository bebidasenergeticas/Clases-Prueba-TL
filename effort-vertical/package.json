{
  "name": "claude-effort-vertical",
  "version": "1.0.0",
  "private": true,
  "description": "Vertical 9:16 recreation of the Claude effort-levels animation, built with Remotion + SVG",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts EffortEvolution out/effort-vertical.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --x264-preset=slow",
    "render:sfx": "node scripts/generate-sfx.mjs && remotion render src/index.ts EffortEvolution out/effort-vertical-sfx.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --x264-preset=slow --props=props/with-audio.json",
    "render:preview": "remotion render src/index.ts EffortEvolution out/effort-vertical-preview.mp4 --codec=h264 --crf=24 --scale=0.5",
    "render:frame": "remotion still src/index.ts EffortEvolution out/frame.png",
    "render:stills": "node scripts/render-stills.mjs",
    "analyze:reference": "bash scripts/analyze-reference.sh",
    "sfx": "node scripts/generate-sfx.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3",
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532"
  }
}
