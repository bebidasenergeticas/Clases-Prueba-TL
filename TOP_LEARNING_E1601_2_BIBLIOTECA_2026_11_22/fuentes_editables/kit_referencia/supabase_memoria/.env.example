# Copia este archivo como .env (NUNCA subas .env a GitHub: agrega ".env" a .gitignore).
# Puerto A&M - SIMULACION ACADEMICA. Todos los valores se dejan VACIOS aqui a proposito.
# Doc oficial de claves: https://supabase.com/docs/guides/getting-started/api-keys (verificado 23/11/2026)

# Project URL (Dashboard > boton Connect del proyecto). Ejemplo de forma: https://<ref-del-proyecto>.supabase.co
SUPABASE_URL=

# Clave publishable (formato sb_publishable_...). Segura para frontend SOLO si RLS esta activo.
SUPABASE_PUBLISHABLE_KEY=

# Clave secret (formato sb_secret_...). SOLO servidor. Salta RLS. NUNCA en frontend, chat, prompt ni GitHub.
# Esta practica NO la necesita: la memoria usa el JWT del usuario + RLS. Dejala vacia salvo tareas de administracion.
SUPABASE_SECRET_KEY=

# Clave del router de modelos (solo backend). Ver la guia de OpenRouter.
OPENROUTER_API_KEY=
